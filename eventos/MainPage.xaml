<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="eventos.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Label 
Text="Nombre del usuario" 
FontSize="18" 
FontAttributes="Bold" 
TextColor="DarkBlue" 
HorizontalTextAlignment="Center" />

            <Entry 
x:Name="correoEntry" 
Placeholder="correo@ejemplo.com" 
Keyboard="Email" 
MaxLength="80" />
            <Editor 
x:Name="comentariosEditor" 
Placeholder="Escribe tus comentarios" 
AutoSize="TextChanges" 
MaxLength="300" 
HeightRequest="120" />
            <Button 
Text="Guardar" 
BackgroundColor="DarkBlue" 
TextColor="White" 
CornerRadius="8" 
Clicked="Button_Clicked"/>
            <Image 
Source="logo.png" 
Aspect="AspectFit" 
HeightRequest="120"/>
            <HorizontalStackLayout Spacing="8">
                <CheckBox 
x:Name="condicionesCheckBox" 
Color="DarkBlue" />
                <Label Text="Acepto las condiciones" />
            </HorizontalStackLayout>
            <Switch 
x:Name="notificacionesSwitch" 
IsToggled="True" 
OnColor="Green" 
ThumbColor="White" 
Toggled="notificacionesSwitch_Toggled" />
            <Picker 
x:Name="cursoPicker" 
Title="Selecciona un curso">
                <Picker.Items>
                    <x:String>DAM1</x:String>
                    <x:String>DAM2</x:String>
                </Picker.Items>
            </Picker>
            <DatePicker 
x:Name="fechaDatePicker" 
Format="dd/MM/yyyy" 
MinimumDate="01/01/2000" 

DateSelected="fechaDatePicker_DateSelected" />
            <Slider 
x:Name="volumenSlider" 
Minimum="0" 
Maximum="100" 
Value="50" 
MinimumTrackColor="DarkBlue" 
ThumbColor="Orange" 
ValueChanged="volumenSlider_ValueChanged" />
        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage>
