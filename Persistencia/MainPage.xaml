<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Persistencia.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
           
            <Label
                Text="Persistencia"
                TextColor="White"
                
                 />

           

            <Button
                x:Name="PreferenciasBtn"
                Text="Preferencias" 
               
                Clicked="PreferenciasBtn_Clicked"
                HorizontalOptions="Fill" />
            <Button
     x:Name="FicheroBtn"
     Text="Fichero" 
    
     Clicked="FicheroBtn_Clicked"
     HorizontalOptions="Fill" />
            <Button
     x:Name="BasedeDatosBtn"
     Text="BasedeDatos" 
     
     Clicked="BasedeDatosBtn_Clicked"
     HorizontalOptions="Fill" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
