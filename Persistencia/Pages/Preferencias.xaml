<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Persistencia.Pages.Preferencias"
             Title="Preferencias">

    <VerticalStackLayout Spacing="15" Padding="20">

        <HorizontalStackLayout Spacing="10">
            <Label Text="Nombre:"
                   VerticalOptions="Center" />
            <Entry x:Name="nombretext"
                   HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Contraseña:"
                   VerticalOptions="Center" />
            <Entry x:Name="contrasenatext" 
                   Keyboard="Password"
                   HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Spacing="10">
            <Label Text="Recuérdame" 
                   VerticalOptions="Center" />
            <CheckBox x:Name="checktext"/>
        </HorizontalStackLayout>

        <Button x:Name="aceptar" 
                Text="Aceptar" 
                BackgroundColor="Blue" 
                TextColor="White"
                Clicked="aceptar_Clicked" />
        <!-- ¡Aquí faltaba cerrar el '>'! -->

    </VerticalStackLayout>
</ContentPage>