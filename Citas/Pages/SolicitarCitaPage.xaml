<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Citas.Pages.SolicitarCitaPage"
             Title="SolicitarCitaPage">
    <VerticalStackLayout>
        <Label Text="Datos del paciente" FontSize="20" FontAttributes="Bold" />
        <Entry 
x:Name="NombreEntry" 
Placeholder="Nombre" 
 />
      
        <Entry 
x:Name="ApellidosEntry" 
Placeholder="Apellidos" 
 />
        <Entry 
x:Name="NumeroEntry" 
Placeholder="Numero de paciente" 
Keyboard="Numeric" 
 />
        <Picker 
x:Name="cursoPicker" 
Title="Preferencia de turno">
            <Picker.Items>
                <x:String>Mañana</x:String>
                <x:String>Tarde</x:String>
            </Picker.Items>
        </Picker>
        <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
            <CheckBox x:Name="condicionesCheckBox" Color="DarkBlue" />
            <Label Text="Recuerda mis datos" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <Button Text="Solicitar cita" 
                    Clicked="OnSolicitarCitaClicked"
                    Margin="0,20,0,0" />
    </VerticalStackLayout>
</ContentPage>