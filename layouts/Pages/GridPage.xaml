<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="layouts.Pages.GridPage"
             Title="GridPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Fila 0 -->
        <Button x:Name="Boton1" Text="Boton 1" Grid.Row="0" Grid.Column="0"/>
        <Button x:Name="Boton2" Text="Boton 2" Grid.Row="0" Grid.Column="1"/>
        <Button x:Name="Boton3" Text="Boton 3" Grid.Row="0" Grid.Column="2"/>
        <Button x:Name="Boton4" Text="Boton 4" Grid.Row="0" Grid.Column="3"/>

        <!-- Fila 1 -->
        <Button x:Name="Boton5" Text="Boton 5" Grid.Row="1" Grid.Column="0"/>
        <Button x:Name="Boton65" Text="Boton 6.5" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" BackgroundColor="Red"/>
        <Button x:Name="Boton8" Text="Boton 8" Grid.Row="1" Grid.Column="3"/>

        <!-- Filas 2 y 3 -->
        <Button x:Name="Boton9" Text="Boton 9" Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" BackgroundColor="Red"/>
    </Grid>
</ContentPage>